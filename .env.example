# ============================================================
# MdbUP — esempio di configurazione (Fase 1 / bozza Fase 2)
# ============================================================
# Copiare in .env e sostituire OGNI valore "CHANGE_ME".
# Non inserire mai segreti reali in questo file o nel repository.
#
# In produzione i segreti di infrastruttura (chiave di cifratura,
# bootstrap token, password PostgreSQL) vanno forniti come Docker
# secrets o file read-only, non come variabili in chiaro.
#
# Le credenziali delle integrazioni (TMDb, MDBList, JustWatch)
# NON vanno qui: si inseriscono dall'interfaccia Impostazioni
# e vengono cifrate nel database con APP_ENCRYPTION_KEY.
# ============================================================

# --- Applicazione ---
APP_ENV=production
APP_BASE_URL=https://mdblist-sync.example.com
APP_TIMEZONE=Europe/Rome
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- PostgreSQL ---
POSTGRES_DB=mdbup
POSTGRES_USER=mdbup
# In produzione usare POSTGRES_PASSWORD_FILE con Docker secret.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PASSWORD_FILE=
DATABASE_URL=postgresql+psycopg://mdbup:CHANGE_ME_STRONG_PASSWORD@postgres:5432/mdbup
# Alternativa consigliata: DATABASE_URL_FILE=/run/secrets/database_url
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Sicurezza ---
# 32 byte base64; in produzione usare APP_ENCRYPTION_KEY_FILE.
APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
APP_ENCRYPTION_KEY_FILE=/run/secrets/app_encryption_key
APP_ENCRYPTION_KEY_VERSION=1
# Keyring opzionale per la rotazione: {"1":"<base64>","2":"<base64>"}
# La versione attiva deve essere presente anche in APP_ENCRYPTION_KEY.
APP_ENCRYPTION_KEYS=
BOOTSTRAP_TOKEN=CHANGE_ME_ONE_TIME_BOOTSTRAP_TOKEN
BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap_token
# I nomi base sono mdbsync-session/mdbsync-csrf. Con COOKIE_SECURE=true il
# backend aggiunge automaticamente __Host- e Secure; in LAN lo rimuove.
SESSION_COOKIE_NAME=mdbsync-session
CSRF_COOKIE_NAME=mdbsync-csrf
SESSION_TTL_DAYS=7
SESSION_IDLE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=30

# --- Fonte predefinita e scheduling ---
# Fonte predefinita nel builder: justwatch | tmdb.
DEFAULT_SOURCE=justwatch
# Acquisizione scaglionata JustWatch: 96 slot da 15 min, max 1 per tick.
CATALOG_SCHEDULE_ENABLED=true

# --- Immagine applicativa ---
# Default: immagine GHCR pubblicata dal workflow Build image.
# Per una build locale: docker build -f deploy/Dockerfile.api -t mdbup-api:local .
# e impostare MDBUP_IMAGE=mdbup-api:local.
MDBUP_IMAGE=ghcr.io/dexxtex/mdbup:latest

# --- Porte host (compose) ---
# API: esposta su tutte le interfacce per il reverse proxy.
# PostgreSQL/Redis: solo loopback, per psql/redis-cli dall'host.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Web ---
# L'app espone solo HTTP su WEB_PORT. TLS, HSTS e reverse proxy sono esterni:
# ognuno può usare Caddy, Nginx, Traefik, Tailscale, ecc.
WEB_PORT=28080
COOKIE_SECURE=true
CORS_ORIGINS=
# Con reverse proxy TLS: APP_BASE_URL=https://<dominio> e COOKIE_SECURE=true.
# In LAN HTTP: APP_BASE_URL=http://<ip>:28080 e COOKIE_SECURE=false.

# --- Scheduler ---
SCHEDULER_POLL_SECONDS=60
SCHEDULER_ENABLED=true

# --- Policy di sincronizzazione ---
SYNC_BATCH_SIZE=100
SYNC_MAX_REMOVAL_ABSOLUTE=50
SYNC_MAX_REMOVAL_PERCENT=10
SYNC_MAX_ADDITION_PERCENT=50
SNAPSHOT_RETENTION_DAYS=90
RUN_RETENTION_DAYS=180
FAILED_RUN_RETENTION_DAYS=90
JOB_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=7
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_MS=500
HTTP_BACKOFF_MAX_MS=30000
HTTP_JITTER_RATIO=0.30

# --- JustWatch endpoint pubblico (NON la Partner API) ---
# Fonte attiva: nessuna credenziale richiesta. La Partner API resta invece
# bloccata da contratto (fonte justwatch_partner, DISABLED).
JUSTWATCH_BASE_URL=https://apis.justwatch.com/graphql
JUSTWATCH_LANGUAGE=it
# Intervallo minimo tra due chiamate. L'endpoint non espone rate limit e non
# avvisa prima di un blocco: il throttle è l'unica protezione. Non scendere
# sotto 1000 in uso reale.
JUSTWATCH_MIN_INTERVAL_MS=1000

# --- Notifiche ---
NOTIFICATIONS_SUMMARY_ENABLED=false
NOTIFICATIONS_SUMMARY_HOUR=8

# --- Osservabilità ---
METRICS_ENABLED=true
# Token per GET /api/metrics (Bearer o X-Metrics-Token). Senza token l'endpoint
# risponde 503: non è mai pubblico. In produzione usare METRICS_TOKEN_FILE.
METRICS_TOKEN=

# --- Backup ---
# Directory host montata in sola lettura su /backups in api/worker.
BACKUP_HOST_DIR=../backups
BACKUP_DIR=/backups
BACKUP_STATUS_FILE=/backups/last_backup.json
# Chiave privata age per la verifica con decifratura (solo host/CLI, mai nei container).
BACKUP_AGE_IDENTITY_FILE=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_DAYS=180
# Chiave pubblica age per cifrare i backup (es. age1...).
# La chiave privata va conservata FUORI dal server.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_RECIPIENT_FILE=/run/secrets/backup_age_recipient
