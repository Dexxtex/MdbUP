# ============================================================
# MdbUP — configurazione di esempio (stack autonomo a 4 servizi)
# ============================================================
# Questo file è solo documentazione: il compose della root NON lo legge.
# Imposta le stesse variabili nell'ambiente di Dockhand o della shell.
#
# I default del compose sono volutamente semplici per il primo avvio.
# Sostituiscili prima di esporre il servizio in rete.
# Non inserire segreti reali in questo file o nel repository.
# ============================================================

# --- Immagine e porta ---
MDBUP_IMAGE=ghcr.io/dexxtex/mdbup:latest
WEB_PORT=28080

# --- Applicazione ---
APP_ENV=production
# Origine esatta usata da CSRF e cookie. In LAN: http://<host>:28080.
APP_BASE_URL=http://<host>:28080
APP_TIMEZONE=Europe/Rome
LOG_LEVEL=INFO
LOG_FORMAT=json
COOKIE_SECURE=false
# IP/host del reverse proxy autorizzato a impostare X-Forwarded-For (vuoto = diretto).
TRUSTED_PROXIES=

# --- PostgreSQL ---
POSTGRES_DB=mdbup
POSTGRES_USER=mdbup
# Non cambiare dopo il primo avvio: il database è già inizializzato.
POSTGRES_PASSWORD=mdbup

# --- Sicurezza ---
# Base64 di 32 byte. Non cambiare dopo il primo avvio: le credenziali salvate
# non sarebbero più decifrabili.
# Generazione: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
APP_ENCRYPTION_KEY_VERSION=1
# Usato una sola volta su /bootstrap. Sostituirlo dopo il bootstrap.
BOOTSTRAP_TOKEN=bootstrap

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Fonte predefinita e scheduling ---
DEFAULT_SOURCE=justwatch
CATALOG_SCHEDULE_ENABLED=true

# --- Backup ---
# Il volume `mdbup_v2_backups` è montato su /backups in api/worker.
BACKUP_DIR=/backups
BACKUP_STATUS_FILE=/backups/last_backup.json
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_DAYS=180
# Chiave pubblica age (es. age1...). La privata resta FUORI dal server.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=

# --- Osservabilità ---
METRICS_ENABLED=true
# Token per GET /api/metrics (Bearer o X-Metrics-Token).
METRICS_TOKEN=metrics

# --- JustWatch pubblico ---
# Endpoint pubblico, non la Partner API. Il throttle è 1 req/s.
JUSTWATCH_BASE_URL=https://apis.justwatch.com/graphql
JUSTWATCH_LANGUAGE=it
JUSTWATCH_MIN_INTERVAL_MS=1000

# --- Notifiche ---
NOTIFICATIONS_SUMMARY_ENABLED=false
NOTIFICATIONS_SUMMARY_HOUR=8

# --- Policy di sincronizzazione ---
SYNC_BATCH_SIZE=100
SYNC_MAX_REMOVAL_ABSOLUTE=50
SYNC_MAX_REMOVAL_PERCENT=10
SYNC_MAX_ADDITION_PERCENT=50
SNAPSHOT_RETENTION_DAYS=90
RUN_RETENTION_DAYS=180
FAILED_RUN_RETENTION_DAYS=90
JOB_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=7
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE_MS=500
HTTP_BACKOFF_MAX_MS=30000
HTTP_JITTER_RATIO=0.30
