# Contesto di build della radice del repository (deploy/Dockerfile.api).
# Obiettivo: contesto minimo e nessun segreto nell'immagine.

# Controllo versione e metadati
.git
.gitignore
.github

# Documentazione
docs

# Il frontend viene compilato nello stage Node di deploy/Dockerfile.api.
# Segreti e configurazione locale
.env
.env.*
!.env.example
secrets
*.pem
*.key

# Dati e artefatti locali
backups
.tmp
*.log
*.db
*.sqlite3

# Python
**/__pycache__
**/*.py[cod]
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
htmlcov
**/*.egg-info

# Test: non servono nel runtime (la CI li esegue sull'host)
backend/tests

# Node
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo
